CONFIG_IDF_TARGET="esp32p4"
# this board's chip is rev v1.3; IDF 5.5 defaults to v3+ silicon
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# the four USB-A ports may sit behind an onboard hub
CONFIG_USB_HOST_HUBS_SUPPORTED=y
CONFIG_USB_HOST_HUB_MULTI_LEVEL=y
# USB transfer buffers in PSRAM. A stick read can need a ~32 KB DMA buffer;
# from internal RAM that failed once the largest free block dropped below it,
# and usb_host_msc then double-freed its transfer and the heap asserted.
CONFIG_USB_HOST_DWC_DMA_CAP_MEMORY_IN_PSRAM=y
# long filenames on the SD card
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# 32 MB in-package PSRAM (hex mode, 200 MHz) — same settings the board's
# Linux-emulator build used. Holds the track streaming window.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_HEX=y
CONFIG_SPIRAM_SPEED_200M=y
# 1 ms tick: short vTaskDelay()s in the loader must not round down to 0
CONFIG_FREERTOS_HZ=1000

# LVGL (deck screen): small allocations in PSRAM (lvgl_mem.c), dark theme,
# and the font sizes the UI uses.
CONFIG_LV_USE_CUSTOM_MALLOC=y   # lvgl_mem.c: objects in PSRAM
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_THEME_DEFAULT_DARK=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_40=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_16=y
CONFIG_LV_DEF_REFR_PERIOD=20

# Our own table (partitions.csv): an 8 MB app partition. The app outgrew
# 1 MB with LVGL, then the 1.5 MB "single app large" table too.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Audio runs per-sample code every block; -Og was too slow. Bigger L2 so the
# UI on core 0 does not evict the audio path (both cores share it).
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_CACHE_L2_CACHE_256KB=y

# Per-core CPU load in the status report (idle-task run time).
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y

# Pro DJ Link over the on-board Ethernet. Link-local (169.254.x.x) when
# there's no DHCP server, as on a cable straight to a Pioneer player. The
# lwIP task stays on core 0 with the rest of the network.
CONFIG_LWIP_AUTOIP=y
CONFIG_LWIP_TCPIP_TASK_AFFINITY_CPU0=y

# Boot: skip the 32 MB PSRAM self-test (about 1 s on every boot), so the
# splash appears sooner. It only finds faulty RAM, which a deck that boots
# and plays would show anyway.
CONFIG_SPIRAM_MEMTEST=n
