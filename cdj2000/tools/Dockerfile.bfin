# GNU binutils and GCC (C only, no libc) for the ADSP-BF531 (bfin-elf): the
# CDJ-2000's display processor program.  No vendor tools needed.
#   docker build -t freedj-bfin-gcc -f tools/Dockerfile.bfin tools
FROM ubuntu:24.04
RUN apt-get update && apt-get install -y --no-install-recommends build-essential wget ca-certificates texinfo bison flex \
      libgmp-dev libmpfr-dev libmpc-dev xz-utils \
    && rm -rf /var/lib/apt/lists/*
RUN wget -q https://ftp.gnu.org/gnu/binutils/binutils-2.42.tar.xz && tar xf binutils-2.42.tar.xz \
    && cd binutils-2.42 && ./configure --target=bfin-elf --prefix=/opt/bfin --disable-nls --disable-werror -q \
    && make -j8 >/dev/null && make install >/dev/null && cd / && rm -rf binutils-2.42*
ENV PATH=/opt/bfin/bin:$PATH
RUN wget -q https://ftp.gnu.org/gnu/gcc/gcc-13.3.0/gcc-13.3.0.tar.xz && tar xf gcc-13.3.0.tar.xz && mkdir gcc-build \
    && cd gcc-build && ../gcc-13.3.0/configure --target=bfin-elf --prefix=/opt/bfin --enable-languages=c --without-headers \
         --with-newlib --disable-nls --disable-shared --disable-threads --disable-libssp --disable-libgomp \
         --disable-libquadmath --disable-libatomic -q \
    && make -j8 all-gcc all-target-libgcc >/dev/null 2>&1 && make install-gcc install-target-libgcc >/dev/null \
    && cd / && rm -rf gcc-13.3.0* gcc-build
